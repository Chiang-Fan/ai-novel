# AI智能小说创作系统 - 云服务器环境配置文件
# 部署到云服务器后，将此文件重命名为 .env 并修改配置

# ==================== AI服务配置 ====================
# 通义千问 API配置（必填）
QWEN_API_KEY=your_qwen_api_key_here
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Spring AI配置（使用通义千问）
SPRING_AI_OPENAI_API_KEY=${QWEN_API_KEY}
SPRING_AI_OPENAI_BASE_URL=${QWEN_API_BASE}
DASHSCOPE_API_KEY=${QWEN_API_KEY}

# ==================== 数据库配置 ====================
# MySQL数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_novel_writer
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# 数据库连接池配置
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5

# ==================== 服务器配置 ====================
# 服务端口
SERVER_PORT=8080

# 运行环境（dev/test/prod）
SPRING_PROFILES_ACTIVE=prod

# ==================== JVM配置 ====================
# JVM内存配置（可选，默认值已在启动脚本中设置）
# JVM_OPTS=-Xms512m -Xmx2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ==================== 日志配置 ====================
# 日志级别（可选）
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_AIWRTIER=INFO

# ==================== 其他配置 ====================
# 文件上传限制（MB）
MAX_FILE_SIZE=10
MAX_REQUEST_SIZE=20

# 跨域配置（如需要）
# CORS_ALLOWED_ORIGINS=http://your-domain.com,https://your-domain.com
